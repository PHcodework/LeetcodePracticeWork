//Given a non-negative integer x, return the square root of x rounded down to the nearest integer. The returned integer should be non-negative as well.
//You must not use any built-in exponent function or operator.
class Solution {
    public int mySqrt(int x) {
        //if value is 0, the square root is just 0.
        if (x == 0) {
            return x;
        }


        long root = 1;
        long min = 1; //start point of the values
        long max = x; //end point of the possible values

        //iterate through the values using binary search (split in half over and over until answer is found)
        while (min <= max) {
            long mid = min + (max - min) / 2;

            //if the current middle value is the square root (mid * mid = ans), set as root!
            if (mid * mid <= x) {
                root = mid;
                min = mid + 1;
            } else { //if not, set new end point to the values (decrement by 1)
                max = mid - 1;
            }
        };

        //return the root
        return (int) root;
    }
}
