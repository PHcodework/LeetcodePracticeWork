//You are given a 0-indexed array of distinct integers nums.
//There is an element in nums that has the lowest value and an element that has the highest value. We call them the minimum and maximum respectively. Your goal is to remove both these elements from the array.
//A deletion is defined as either removing an element from the front of the array or removing an element from the back of the array.
//Return the minimum number of deletions it would take to remove both the minimum and maximum element from the array.

class Solution {
    public int minimumDeletions(int[] nums) {
        //set minimum and maximum values to the value at 0 by default
        int min = nums[0];
        int max = nums[0];

        //set indexes of the minimum and maximum to 0 by default
        int minIndex = 0;
        int maxIndex = 0;

        //cycle through array, reviewing each digit
        for(int i = 1; i < nums.length; i++){
            //if the current value in the array is higher than the maximum, set the maximum (and maximum index) accordingly.
            if(nums[i] > max){
                max = nums[i];
                maxIndex = i;
            }
            //if the current value int he array is lower than the minimum, set the minimum (and minumum index) accordingly.
            if(nums[i] < min){
                min = nums[i];
                minIndex = i;
            }
        }

        //determine how many deletions it would take to delete min/max from the left
        int left = Math.max(minIndex, maxIndex) + 1;

        //determine how many deletions it would take to delete min/max from the right
        int right = nums.length - Math.min(minIndex, maxIndex);

        //determine how many deletions it would take to delete min/max from both sides
        int both = Math.min(minIndex, maxIndex) + 1 + nums.length - Math.max(minIndex, maxIndex);

        //return the method with the least number of deletions
        return Math.min(left, Math.min(right, both));
    }
}
