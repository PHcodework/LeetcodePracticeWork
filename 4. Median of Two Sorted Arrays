//Given two sorted arrays nums1 and nums2 of size m and n respectively, return the median of the two sorted arrays.
//The overall run time complexity should be O(log (m+n)).
class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {

        //we're going to use binary search for this approach
        //find the smaller array, if nums1 is smaller, use binary search on nums1
        if (nums1.length > nums2.length) {
            return findMedianSortedArrays(nums2, nums1);
        }

        int n1 = nums1.length;
        int n2 = nums2.length;

        //set a low and high range for the binary search in nums1
        int low = 0, high = n1;

        while (low <= high) {
            int cut1 = (low + high) / 2; //how many elements will be placed into the left half (cut1)
            int cut2 = (n1 + n2 + 1) / 2 - cut1; //how many elements will be placed into the right half (cut2)

            //if the left side of nums1 or nums2 is empty, use min_value
            int left1 = (cut1 == 0) ? Integer.MIN_VALUE : nums1[cut1 - 1];
            int left2 = (cut2 == 0) ? Integer.MIN_VALUE : nums2[cut2 - 1];

            //if the right side of nums1 or nums2 is empty, use max_value
            int right1 = (cut1 == n1) ? Integer.MAX_VALUE : nums1[cut1];
            int right2 = (cut2 == n2) ? Integer.MAX_VALUE : nums2[cut2];

            //check if partition is value (all left elements must be greater than or equal to all right side elements)
            if (left1 <= right2 && left2 <= right1) {
                //if total number is even, return the average of the two middle values
                if ((n1 + n2) % 2 == 0) {
                    return (Math.max(left1, left2) + Math.min(right1, right2)) / 2.0;
                //if the total number is odd, the median is the largest number on the left
                } else {
                    return Math.max(left1, left2);
                }
            //if too many large elements from nums1 are on the left, move cut to the left
            } else if (left1 > right2) {
                high = cut1 - 1;
            //if too few large elements from nums1 are on the left, move cut to the right
            } else {
                low = cut1 + 1;
            }
        }
        // fallback for invalid input; normally unreachable
        // when both arrays are sorted and the input is valid.
        return 0.0; 
    }
}
