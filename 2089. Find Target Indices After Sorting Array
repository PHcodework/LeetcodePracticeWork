//You are given a 0-indexed integer array nums and a target element target.
//A target index is an index i such that nums[i] == target.
//Return a list of the target indices of nums after sorting nums in non-decreasing order.
//If there are no target indices, return an empty list. 
//The returned list must be sorted in increasing order.
import java.util.ArrayList;
import java.util.List;

class Solution {
    public List<Integer> targetIndices(int[] nums, int target) {
        int countLess = 0; //number of elements less than the target
        int countEqual = 0; //number of elements equal to the target
        
        // Count elements smaller than and equal to target
        for (int num : nums) {
            //if less, increment the number of elements less than the target
            if (num < target) {
                countLess++;
            //if equal, increment the number of elements equal to the target
            } else if (num == target) {
                countEqual++;
            }
        }
        
        // Generate the resulting list of indices
        List<Integer> result = new ArrayList<>();
        //loop forward through the array with the length of equal integers
        for (int i = 0; i < countEqual; i++) {
            result.add(countLess + i);
        }
        
        return result;
    }
}
