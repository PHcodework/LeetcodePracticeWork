//Given a string s containing just the characters '(', ')', '{', '}', '[' and ']', determine if the input string is valid.
//An input string is valid if:
    //1. Open brackets must be closed by the same type of brackets.
    //2. Open brackets must be closed in the correct order.
    //3. Every close bracket has a corresponding open bracket of the same type.
class Solution {
    public boolean isValid(String s) {
        //create a stack to push each character and compare
        Stack<Character> stack = new Stack<>();

        //iterate through the string, pushing each opening parenthesis to the stack
        for (char ch : s.toCharArray()) {
            //if a character is an open parenthesis, push to the stack
            if (ch == '(' || ch == '[' || ch == '{') {
                stack.push(ch);
            } else {
                //if there are no opening parentheses, return false
                if (stack.isEmpty()) {
                    return false;
                }
                //if the character is a closing parenthesis/bracket and the string doesn't include an opening parenthesis/bracket, return falase
                char top = stack.pop();
                if (ch == ')' && top != '(') {
                    return false;
                }
                if (ch == ']' && top != '[') {
                    return false;
                }
                if (ch == '}' && top != '{') {
                    return false;
                }
            }
        }
        //if the stack is empty (i.e. if all pairs have been matched), return true!
        return stack.isEmpty();
    }
}
