//Given an integer x, return true if x is a palindrome, and false otherwise.

class Solution {
    public boolean isPalindrome(int x) {

        //if the number is negative, there's no way for it to be a palindrome (negative symbol ruins it)
        if(x < 0){
            return false;
        }

        int reverse = 0; //create base for the panildrome number
        int original = x; //copy x to "feed" it to the reverse palindrome number

        //begin cycling through the digits of the original number
        while(x != 0){
            //separate digit from the original, add it to the reverse
            int digit = x % 10; 
            reverse = reverse * 10 + digit; 
            x /= 10; //remove the digit
        }

        return reverse == original; //compare the reverse of x to x
    }
}
