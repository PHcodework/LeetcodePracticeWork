/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int res = 0;
    public int averageOfSubtree(TreeNode root) {
        //recursively traverse the TreeNode.
        ans(root);
        return res; //return number of nodes where the value of the node is equal to the average
    }
    private int[] ans(TreeNode node){
        //if node is null, return empty TreeNode.
        if(node == null){
            return new int[]{0,0};
        }
        //find the sum of both the left and right subtrees.
        int[] left = ans(node.left);
        int[] right = ans(node.right);

        int sum = left[0] + right[0] + node.val; //sum = total sum of nodes
        int divSum = left[1] + right[1] + 1; //divsum = total count of nodes

        int avg = sum/divSum; //average = total sum of nodes / total count of nodes!

        //if the average is equal to the node's current value, increase res.
        if(avg == node.val){
            res++;
        }

        return new int[]{sum, divSum}; //return a new TreeNode including the total sum of nodes and total count of nodes
    }
}
